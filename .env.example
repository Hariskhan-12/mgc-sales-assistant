# --- AWS Bedrock (default) ---
LLM_API_KEY=ABSK_your_bedrock_api_key_here
AWS_REGION=us-east-1
LLM_MODEL=arn:aws:bedrock:us-east-1:ACCOUNT_ID:application-inference-profile/PROFILE_ID

